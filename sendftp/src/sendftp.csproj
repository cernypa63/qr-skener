<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SENDFTP</AssemblyName>
    <RootNamespace>SendFtp</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SENDFTP</Product>
    <Description>Odeslání souboru na FTP s uloženými přístupovými údaji</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../ftpdir/src/FtpKlient.cs" />
    <Compile Include="../../ftpdir/src/VypisFtp.cs" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
